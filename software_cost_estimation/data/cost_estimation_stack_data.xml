<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="stack_odoo" model="cost.estimation.stack">
            <field name="name">Odoo</field>
            <field name="code">ODOO</field>
            <field name="sequence">10</field>
            <field name="productivity_factor">0.60</field>
            <field name="note">Low-code ERP: ORM, views, ACL and reporting scaffolded out of the box.</field>
        </record>

        <record id="stack_django" model="cost.estimation.stack">
            <field name="name">Django (Python)</field>
            <field name="code">DJANGO</field>
            <field name="sequence">20</field>
            <field name="productivity_factor">0.80</field>
            <field name="note">Batteries-included framework; admin and ORM reduce boilerplate.</field>
        </record>

        <record id="stack_laravel" model="cost.estimation.stack">
            <field name="name">Laravel (PHP)</field>
            <field name="code">LARAVEL</field>
            <field name="sequence">30</field>
            <field name="productivity_factor">0.80</field>
            <field name="note">Rapid full-stack PHP framework with scaffolding and Eloquent ORM.</field>
        </record>

        <record id="stack_rails" model="cost.estimation.stack">
            <field name="name">Ruby on Rails</field>
            <field name="code">RAILS</field>
            <field name="sequence">40</field>
            <field name="productivity_factor">0.80</field>
            <field name="note">Convention-over-configuration; fast CRUD delivery.</field>
        </record>

        <record id="stack_aspnet" model="cost.estimation.stack">
            <field name="name">ASP.NET Core (C#)</field>
            <field name="code">ASPNET</field>
            <field name="sequence">50</field>
            <field name="productivity_factor">0.95</field>
            <field name="note">Enterprise .NET stack; typed, robust, more explicit wiring.</field>
        </record>

        <record id="stack_springboot" model="cost.estimation.stack">
            <field name="name">Spring Boot (Java)</field>
            <field name="code">SPRING</field>
            <field name="sequence">60</field>
            <field name="productivity_factor">1.00</field>
            <field name="note">Baseline: hand-built backend services plus a separate SPA front end.</field>
        </record>

        <record id="stack_mern" model="cost.estimation.stack">
            <field name="name">MERN (Node + React)</field>
            <field name="code">MERN</field>
            <field name="sequence">70</field>
            <field name="productivity_factor">1.00</field>
            <field name="note">JavaScript full stack; flexible but mostly hand-written CRUD and UI.</field>
        </record>

        <record id="stack_microservices" model="cost.estimation.stack">
            <field name="name">Bespoke Micro-services</field>
            <field name="code">MICRO</field>
            <field name="sequence">80</field>
            <field name="productivity_factor">1.20</field>
            <field name="note">Independently deployable services; extra infra, contracts and ops effort.</field>
        </record>

        <record id="stack_mobile_native" model="cost.estimation.stack">
            <field name="name">Native Mobile (iOS + Android)</field>
            <field name="code">MOBILE</field>
            <field name="sequence">90</field>
            <field name="productivity_factor">1.25</field>
            <field name="note">Two native codebases; higher per-feature effort.</field>
        </record>

        <record id="stack_other" model="cost.estimation.stack">
            <field name="name">Other / Mixed</field>
            <field name="code">OTHER</field>
            <field name="sequence">100</field>
            <field name="productivity_factor">1.00</field>
            <field name="note">Neutral baseline; adjust the factor to match your delivery data.</field>
        </record>

    </data>
</odoo>
