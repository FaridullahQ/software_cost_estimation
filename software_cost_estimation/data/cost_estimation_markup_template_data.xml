        <field name="is_recurring" eval="False"/>
    </record>

    <record id="markup_training" model="cost.estimation.markup.template">
        <field name="name">Training</field>
        <field name="sequence">30</field>
        <field name="percent">10.0</field>
        <field name="base">tdc</field>
        <field name="is_recurring" eval="False"/>
    </record>

    <record id="markup_documentation" model="cost.estimation.markup.template">
        <field name="name">Documentation</field>
        <field name="sequence">40</field>
        <field name="percent">10.0</field>
        <field name="base">tdc</field>
        <field name="is_recurring" eval="False"/>
    </record>

    <record id="markup_maintenance" model="cost.estimation.markup.template">
        <field name="name">Maintenance (Annual)</field>
        <field name="sequence">50</field>
        <field name="percent">30.0</field>
        <field name="base">tdc</field>
        <field name="is_recurring" eval="True"/>
    </record>

</odoo>
