<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="markup_pm" model="cost.estimation.markup.template">
        <field name="name">Project Management</field>
        <field name="sequence">10</field>
        <field name="percent">25.0</field>
        <field name="base">tdc</field>
        <field name="is_recurring" eval="False"/>
    </record>

    <record id="markup_testing" model="cost.estimation.markup.template">
        <field name="name">Testing &amp; QA</field>
        <field name="sequence">20</field>
        <field name="percent">15.0</field>
