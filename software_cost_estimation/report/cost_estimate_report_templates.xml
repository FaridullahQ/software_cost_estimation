<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_cost_estimate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row mb16">
                            <div class="col-12 text-center">
                                <h2 style="margin-bottom:0;">Information Systems Cost Estimation</h2>
                                <h4 class="text-muted" style="margin-top:2px;">
                                    <span t-field="doc.title"/>
                                </h4>
                            </div>
                        </div>

                        <div class="row mb16">
                            <div class="col-6">
                                <strong>Reference:</strong> <span t-field="doc.name"/><br/>
                                <strong>Client:</strong> <span t-field="doc.partner_id"/><br/>
                                <strong>System:</strong> <span t-field="doc.system_name"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Date:</strong> <span t-field="doc.estimate_date"/><br/>
                                <strong>Estimator:</strong> <span t-field="doc.user_id"/><br/>
                                <strong>Status:</strong> <span t-field="doc.state"/>
                            </div>
                        </div>

                        <div t-if="doc.estimate_type == 'sub_module'"
                             class="alert alert-info" role="alert">
                            <strong>Sub-Module of:</strong>
                            <span t-field="doc.parent_estimate_id.title"/>
                            (<span t-field="doc.parent_estimate_id.name"/>).
                            Shared parameters (scope, duration, architecture,
                            technology variance and stack) and all shared one-time
                            costs are accounted on the parent project; only this
                            sub-module's build effort is shown below.
                        </div>

                        <table t-if="doc.estimate_type != 'sub_module'"
                               class="table table-sm mb16">
                            <thead>
                                <tr>
                                    <th>Scope</th><th>Duration</th><th>Architecture</th>
                                    <th>Tech Variance</th><th>Stack</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-field="doc.scope"/></td>
                                    <td><span t-field="doc.duration_months"/> months</td>
                                    <td><span t-field="doc.architecture"/></td>
                                    <td><span t-field="doc.tech_variance"/></td>
                                    <td><span t-field="doc.stack_id"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4>Labour (Pre-Development)</h4>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Activity</th><th>Responsible</th>
                                    <th class="text-end">Persons</th>
                                    <th class="text-end">Days</th>
                                    <th class="text-end">Person-Hours</th>
                                    <th class="text-end">Rate</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.labor_line_ids" t-as="l">
                                    <td><span t-field="l.name"/></td>
                                    <td><span t-field="l.responsible"/></td>
                                    <td class="text-end"><span t-field="l.persons"/></td>
                                    <td class="text-end"><span t-field="l.working_days"/></td>
                                    <td class="text-end"><span t-field="l.person_hours"/></td>
                                    <td class="text-end"><span t-field="l.hourly_rate"/></td>
                                    <td class="text-end"><span t-field="l.amount"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4>Development Drivers</h4>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Driver</th><th>Method</th>
                                    <th class="text-end">Count</th>
                                    <th class="text-end">Complexity</th>
                                    <th class="text-end">Unit Rate</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.dev_line_ids" t-as="d">
                                    <td><span t-field="d.name"/></td>
                                    <td><span t-field="d.calc_method"/></td>
                                    <td class="text-end"><span t-field="d.count"/></td>
                                    <td class="text-end"><span t-field="d.complexity"/></td>
                                    <td class="text-end"><span t-field="d.unit_rate"/></td>
                                    <td class="text-end"><span t-field="d.amount"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 t-if="doc.estimate_type != 'sub_module'">Markups &amp; Maintenance</h4>
                        <table t-if="doc.estimate_type != 'sub_module'"
                               class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Item</th><th>Base</th>
                                    <th class="text-end">%</th>
                                    <th class="text-center">Recurring</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.markup_line_ids" t-as="m">
                                    <td><span t-field="m.name"/></td>
                                    <td><span t-field="m.base"/></td>
                                    <td class="text-end"><span t-field="m.percent"/>%</td>
                                    <td class="text-center">
                                        <span t-if="m.is_recurring">Yes</span>
                                        <span t-else="">No</span>
                                    </td>
                                    <td class="text-end"><span t-field="m.amount"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-if="doc.estimate_type != 'sub_module' and doc.child_count">
                            <h4>Linked Sub-Modules (Build Effort)</h4>
                            <table class="table table-sm o_main_table">
                                <thead>
                                    <tr>
                                        <th>Sub-Module</th>
                                        <th>Reference</th>
                                        <th class="text-end">Labour</th>
                                        <th class="text-end">Development</th>
                                        <th class="text-end">Build Effort</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.child_estimate_ids" t-as="s">
                                        <td>
                                            <span t-if="s.system_name" t-field="s.system_name"/>
                                            <span t-else="" t-field="s.title"/>
                                        </td>
                                        <td><span t-field="s.name"/></td>
                                        <td class="text-end"><span t-field="s.labor_cost"/></td>
                                        <td class="text-end"><span t-field="s.dev_catalog_cost"/></td>
                                        <td class="text-end"><span t-field="s.build_effort"/></td>
                                    </tr>
                                    <tr style="border-top:1px solid #adb5bd;">
                                        <td colspan="4"><strong>Total Sub-Modules Build Effort</strong></td>
                                        <td class="text-end"><strong><span t-field="doc.child_build_total"/></strong></td>
                                    </tr>
                                </tbody>
                            </table>
                            <p class="text-muted" style="font-size:10px;">
                                Sub-module build effort folds into the Total
                                Development Cost (TDC) below, so this project's
                                markups and contingency are applied once over the
                                consolidated build.
                            </p>
                        </t>

                        <t t-if="doc.has_components">
                            <h4>Reusable Components (Rolled In)</h4>
                            <table class="table table-sm o_main_table">
                                <thead>
                                    <tr>
                                        <th>System / Product</th>
                                        <th>Reference</th>
                                        <th class="text-end">Allocation %</th>
                                        <th class="text-end">CapEx</th>
                                        <th class="text-end">OpEx</th>
                                        <th class="text-end">Year-1</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.component_ids" t-as="c">
                                        <td>
                                            <span t-if="c.sub_system_name" t-field="c.sub_system_name"/>
                                            <span t-else="" t-field="c.sub_title"/>
                                        </td>
                                        <td><span t-field="c.sub_estimate_id.name"/></td>
                                        <td class="text-end"><span t-field="c.allocation_percent"/>%</td>
                                        <td class="text-end"><span t-field="c.allocated_capex"/></td>
                                        <td class="text-end"><span t-field="c.allocated_opex"/></td>
                                        <td class="text-end"><span t-field="c.allocated_total"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <div class="row mt16">
                            <div class="col-5"/>
                            <div class="col-7">
                                <table class="table table-sm" style="border:1px solid #dee2e6;">
                                    <thead>
                                        <tr style="background-color:#f8f9fa;">
                                            <th colspan="2" style="font-size:12px;">Cost Summary</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- ============ Sub-module summary ============ -->
                                        <t t-if="doc.estimate_type == 'sub_module'">
                                            <tr t-if="doc.stack_adjustment">
                                                <td>Stack Productivity Adjustment
                                                    (inherited:
                                                    <span t-field="doc.parent_stack_id"/>)</td>
                                                <td class="text-end"><span t-field="doc.stack_adjustment"/></td>
                                            </tr>
                                            <tr>
                                                <td>Labour (Pre-Development)</td>
                                                <td class="text-end"><span t-field="doc.labor_cost"/></td>
                                            </tr>
                                            <tr>
                                                <td>Development Catalog</td>
                                                <td class="text-end"><span t-field="doc.dev_catalog_cost"/></td>
                                            </tr>
                                            <tr style="background-color:#f1f3f5;border-top:2px solid #000;">
                                                <td style="font-size:13px;">
                                                    <strong>Sub-Module Build Effort</strong></td>
                                                <td class="text-end" style="font-size:13px;">
                                                    <strong><span t-field="doc.build_effort"/></strong></td>
                                            </tr>
                                        </t>

                                        <!-- ========== Independent project summary ========== -->
                                        <t t-if="doc.estimate_type != 'sub_module'">
                                            <tr t-if="doc.stack_adjustment">
                                                <td>Stack Productivity Adjustment
                                                    (<span t-field="doc.stack_id"/>)</td>
                                                <td class="text-end"><span t-field="doc.stack_adjustment"/></td>
                                            </tr>
                                            <t t-if="doc.child_count">
                                                <tr>
                                                    <td>Own Build Effort</td>
                                                    <td class="text-end"><span t-field="doc.build_effort"/></td>
                                                </tr>
                                                <tr>
                                                    <td>Sub-Modules Build Effort</td>
                                                    <td class="text-end"><span t-field="doc.child_build_total"/></td>
                                                </tr>
                                            </t>
                                            <tr>
                                                <td>Total Development Cost (TDC)</td>
                                                <td class="text-end"><span t-field="doc.tdc"/></td>
                                            </tr>
                                            <tr>
                                                <td>Scope</td>
                                                <td class="text-end"><span t-field="doc.scope_cost"/></td>
                                            </tr>
                                            <tr>
                                                <td>Duration</td>
                                                <td class="text-end"><span t-field="doc.duration_cost"/></td>
                                            </tr>
                                            <tr>
                                                <td>One-time Markups</td>
                                                <td class="text-end"><span t-field="doc.markup_one_time"/></td>
                                            </tr>
                                            <tr t-if="doc.contingency_amount">
                                                <td>Contingency</td>
                                                <td class="text-end"><span t-field="doc.contingency_amount"/></td>
                                            </tr>
                                            <tr style="border-top:1px solid #adb5bd;">
                                                <td>One-time Total (CapEx)</td>
                                                <td class="text-end"><span t-field="doc.total_one_time"/></td>
                                            </tr>
                                            <tr>
                                                <td>Annual Maintenance (OpEx)</td>
                                                <td class="text-end"><span t-field="doc.maintenance_annual"/></td>
                                            </tr>
                                            <tr style="border-top:1px solid #adb5bd;">
                                                <td>
                                                    <strong t-if="doc.has_components">Main Module Subtotal (Year 1)</strong>
                                                    <strong t-else="">Grand Total (Year 1)</strong>
                                                </td>
                                                <td class="text-end"><strong><span t-field="doc.grand_total"/></strong></td>
                                            </tr>
                                            <t t-if="doc.has_components">
                                                <tr>
                                                    <td>Reusable Components &#8212; CapEx</td>
                                                    <td class="text-end"><span t-field="doc.components_capex"/></td>
                                                </tr>
                                                <tr>
                                                    <td>Reusable Components &#8212; Annual Maintenance</td>
                                                    <td class="text-end"><span t-field="doc.components_opex"/></td>
                                                </tr>
                                                <tr style="border-top:1px solid #adb5bd;">
                                                    <td><strong>Consolidated Total (Year 1)</strong></td>
                                                    <td class="text-end"><strong><span t-field="doc.consolidated_total"/></strong></td>
                                                </tr>
                                            </t>
                                            <t t-if="doc.discount_amount">
                                                <tr>
                                                    <td>Discount</td>
                                                    <td class="text-end">&#8722; <span t-field="doc.discount_amount"/></td>
                                                </tr>
                                            </t>
                                            <tr style="background-color:#f1f3f5;border-top:2px solid #000;">
                                                <td style="font-size:13px;">
                                                    <strong t-if="doc.discount_amount">Final Price</strong>
                                                    <strong t-elif="doc.has_components">Consolidated Total (Year 1)</strong>
                                                    <strong t-else="">Grand Total (Year 1)</strong>
                                                </td>
                                                <td class="text-end" style="font-size:13px;">
                                                    <strong><span t-field="doc.final_price"/></strong>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <t t-if="doc.discount_amount">
                            <p class="text-muted" style="font-size:10px;">
                                Discount justification: <span t-field="doc.discount_reason"/>
                                <t t-if="doc.discount_reference"> (Ref: <span t-field="doc.discount_reference"/>)</t>
                            </p>
                        </t>

                        <p t-if="doc.estimate_type != 'sub_module'"
                           class="text-muted mt16" style="font-size:10px;">
                            Risk band (PERT): Optimistic <span t-field="doc.optimistic_total"/>
                            / Expected <span t-field="doc.expected_total"/>
                            / Pessimistic <span t-field="doc.pessimistic_total"/>.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
