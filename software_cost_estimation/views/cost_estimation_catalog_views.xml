<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Catalog -->
    <record id="view_cost_estimation_catalog_tree" model="ir.ui.view">
        <field name="name">cost.estimation.catalog.tree</field>
        <field name="model">cost.estimation.catalog</field>
        <field name="arch" type="xml">
            <tree string="Cost Driver Catalog" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="calc_method"/>
                <field name="default_complexity"/>
                <field name="default_unit_rate"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="note" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_cost_estimation_catalog_search" model="ir.ui.view">
        <field name="name">cost.estimation.catalog.search</field>
        <field name="model">cost.estimation.catalog</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="group_category" string="Category"
                        context="{'group_by':'category'}"/>
            </search>
        </field>
    </record>

    <record id="action_cost_estimation_catalog" model="ir.actions.act_window">
        <field name="name">Cost Driver Catalog</field>
        <field name="res_model">cost.estimation.catalog</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_cost_estimation_catalog_search"/>
    </record>

    <!-- Markup templates -->
    <record id="view_cost_estimation_markup_template_tree" model="ir.ui.view">
        <field name="name">cost.estimation.markup.template.tree</field>
        <field name="model">cost.estimation.markup.template</field>
        <field name="arch" type="xml">
            <tree string="Markup Templates" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="base"/>
                <field name="percent"/>
                <field name="is_recurring"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="action_cost_estimation_markup_template" model="ir.actions.act_window">
        <field name="name">Markup Templates</field>
        <field name="res_model">cost.estimation.markup.template</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>
