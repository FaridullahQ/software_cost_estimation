<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="software_cost_estimation.CostEstimateDashboard">
        <div class="o_sce_dashboard">

            <div class="o_sce_topbar">
                <div class="o_sce_title">
                    <i class="fa fa-pie-chart me-2"/>Cost Estimation Dashboard
                </div>
                <div class="o_sce_filters">
                    <select class="form-select form-select-sm"
                            t-on-change="(ev) => this.onFilterChange('year', ev.target.value)">
                        <option value="all">All time</option>
                        <t t-foreach="state.data ? state.data.filters.years : []" t-as="y" t-key="y">
                            <option t-att-value="y" t-att-selected="state.filters.year === y">
                                <t t-esc="y"/>
                            </option>
                        </t>
                    </select>
                    <select class="form-select form-select-sm"
                            t-on-change="(ev) => this.onFilterChange('partner_id', ev.target.value)">
                        <option value="">All projects</option>
                        <t t-foreach="state.data ? state.data.filters.projects : []" t-as="p" t-key="p.id">
                            <option t-att-value="p.id"><t t-esc="p.name"/></option>
                        </t>
                    </select>
                    <select class="form-select form-select-sm"
                            t-on-change="(ev) => this.onFilterChange('state', ev.target.value)">
                        <option value="">All statuses</option>
                        <t t-foreach="state.data ? state.data.filters.states : []" t-as="s" t-key="s.value">
                            <option t-att-value="s.value"><t t-esc="s.label"/></option>
                        </t>
                    </select>
                    <select class="form-select form-select-sm"
                            t-on-change="(ev) => this.onFilterChange('scope', ev.target.value)">
                        <option value="">All scopes</option>
                        <t t-foreach="state.data ? state.data.filters.scopes : []" t-as="s" t-key="s.value">
                            <option t-att-value="s.value"><t t-esc="s.label"/></option>
                        </t>
                    </select>
                    <select class="form-select form-select-sm"
                            t-on-change="(ev) => this.onFilterChange('architecture', ev.target.value)">
                        <option value="">All architectures</option>
                        <t t-foreach="state.data ? state.data.filters.architectures : []" t-as="a" t-key="a.value">
                            <option t-att-value="a.value"><t t-esc="a.label"/></option>
                        </t>
                    </select>
                    <button class="btn btn-sm btn-secondary" t-on-click="() => this.loadData()">
                        <i class="fa fa-refresh"/>
                    </button>
                </div>
            </div>

            <div t-if="state.loading" class="o_sce_loading">
                <i class="fa fa-circle-o-notch fa-spin fa-2x"/>
            </div>

            <div t-else="" class="o_sce_body">

                <div class="o_sce_kpis">
                    <div class="o_sce_kpi">
                        <div class="o_sce_kpi_label">Total pipeline</div>
                        <div class="o_sce_kpi_value"><t t-esc="formatCurrency(state.data.kpi.total_value)"/></div>
                        <div class="o_sce_kpi_sub"><t t-esc="state.data.kpi.count"/> estimates</div>
                    </div>
                    <div class="o_sce_kpi">
                        <div class="o_sce_kpi_label">Approved value</div>
                        <div class="o_sce_kpi_value text-success"><t t-esc="formatCurrency(state.data.kpi.approved_value)"/></div>
                        <div class="o_sce_kpi_sub"><t t-esc="state.data.kpi.approved_count"/> approved</div>
                    </div>
                    <div class="o_sce_kpi">
                        <div class="o_sce_kpi_label">Avg estimate</div>
                        <div class="o_sce_kpi_value"><t t-esc="formatCurrency(state.data.kpi.avg_value)"/></div>
                        <div class="o_sce_kpi_sub">CapEx <t t-esc="formatCurrency(state.data.kpi.capex)"/></div>
                    </div>
                    <div class="o_sce_kpi">
                        <div class="o_sce_kpi_label">Annual OpEx</div>
                        <div class="o_sce_kpi_value"><t t-esc="formatCurrency(state.data.kpi.opex)"/></div>
                        <div class="o_sce_kpi_sub">maintenance / year</div>
                    </div>
                    <div class="o_sce_kpi">
                        <div class="o_sce_kpi_label">Approval rate</div>
                        <div class="o_sce_kpi_value"><t t-esc="Math.round(state.data.kpi.approval_rate)"/>%</div>
                        <div class="o_sce_kpi_sub"><t t-esc="state.data.kpi.pending_count"/> pending · <t t-esc="formatCurrency(state.data.kpi.pending_value)"/></div>
                    </div>
                    <div class="o_sce_kpi">
                        <div class="o_sce_kpi_label">Total effort</div>
                        <div class="o_sce_kpi_value"><t t-esc="formatNumber(state.data.kpi.effort_hours)"/></div>
                        <div class="o_sce_kpi_sub">person-hours</div>
                    </div>
                </div>

                <div class="o_sce_grid">
                    <div class="o_sce_card o_sce_col2">
                        <div class="o_sce_card_title">Estimated value by month</div>
                        <div class="o_sce_chart_scroll">
                            <div class="o_sce_chart_sizer"><canvas t-ref="monthChart"/></div>
                        </div>
                    </div>
                    <div class="o_sce_card">
                        <div class="o_sce_card_title">Pipeline by status</div>
                        <div class="o_sce_chart"><canvas t-ref="stateChart"/></div>
                    </div>
                </div>

                <div class="o_sce_grid">
                    <div class="o_sce_card">
                        <div class="o_sce_card_title">Portfolio cost structure</div>
                        <div class="o_sce_chart"><canvas t-ref="structureChart"/></div>
                    </div>
                    <div class="o_sce_card">
                        <div class="o_sce_card_title">Driver cost by category</div>
                        <div class="o_sce_chart"><canvas t-ref="categoryChart"/></div>
                    </div>
                    <div class="o_sce_card">
                        <div class="o_sce_card_title o_sce_card_title_row">
                            <span>Top projects by value</span>
                            <span class="o_sce_hint"><i class="fa fa-arrows-v"/> scroll</span>
                        </div>
                        <div class="o_sce_scroll">
                            <t t-if="!state.data.top_projects.length">
                                <div class="o_sce_empty">No data for this selection.</div>
                            </t>
                            <t t-foreach="state.data.top_projects" t-as="p" t-key="p_index">
                                <div class="o_sce_rankrow">
                                    <div class="o_sce_rankhead">
                                        <span class="text-truncate"><t t-esc="p.name"/></span>
                                        <span class="o_sce_rankval"><t t-esc="formatCurrency(p.value)"/></span>
                                    </div>
                                    <div class="o_sce_track">
                                        <div class="o_sce_fill" t-attf-style="width: {{p.pct}}%;"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <div class="o_sce_grid">
                    <div class="o_sce_card o_sce_col2">
                        <div class="o_sce_card_title o_sce_card_title_row">
                            <span>Recent estimates</span>
                            <span class="o_sce_hint" t-on-click="() => this.openList()">View all <i class="fa fa-arrow-right"/></span>
                        </div>
                        <div class="o_sce_scroll">
                            <t t-foreach="state.data.recent" t-as="r" t-key="r.id">
                                <div class="o_sce_recent" t-on-click="() => this.openEstimate(r.id)">
                                    <div class="o_sce_recent_main">
                                        <div class="o_sce_recent_title"><t t-esc="r.title"/></div>
                                        <div class="o_sce_recent_sub"><t t-esc="r.partner"/> · <t t-esc="r.ref"/></div>
                                    </div>
                                    <div class="o_sce_recent_right">
                                        <span class="o_sce_value"><t t-esc="formatCurrency(r.value)"/></span>
                                        <span class="o_sce_badge" t-attf-style="background: {{r.state_color}}22; color: {{r.state_color}};">
                                            <t t-esc="r.state_label"/>
                                        </span>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="o_sce_card">
                        <div class="o_sce_card_title">Project deep-dive</div>
                        <select class="form-select form-select-sm mb-2"
                                t-on-change="(ev) => this.onSelectDetail(ev.target.value)">
                            <option value="">Select an estimate…</option>
                            <t t-foreach="state.data.estimates_list" t-as="e" t-key="e.id">
                                <option t-att-value="e.id"><t t-esc="e.name"/></option>
                            </t>
                        </select>
                        <t t-if="state.detail">
                            <div class="o_sce_detail_grid">
                                <div><span>TDC</span><b><t t-esc="formatCurrency(state.detail.tdc)"/></b></div>
                                <div><span>CapEx</span><b><t t-esc="formatCurrency(state.detail.capex)"/></b></div>
                                <div><span>OpEx / yr</span><b><t t-esc="formatCurrency(state.detail.opex)"/></b></div>
                                <div><span>Grand total</span><b><t t-esc="formatCurrency(state.detail.grand_total)"/></b></div>
                                <div><span>Variance</span><b><t t-esc="formatCurrency(state.detail.variance)"/></b></div>
                                <div><span>Effort (h)</span><b><t t-esc="formatNumber(state.detail.effort_hours)"/></b></div>
                            </div>
                            <div class="o_sce_pert">
                                PERT: <t t-esc="formatCurrency(state.detail.optimistic)"/>
                                / <t t-esc="formatCurrency(state.detail.expected)"/>
                                / <t t-esc="formatCurrency(state.detail.pessimistic)"/>
                            </div>
                            <div class="o_sce_chart o_sce_chart_sm"><canvas t-ref="detailChart"/></div>
                        </t>
                        <t t-else="">
                            <div class="o_sce_empty">Pick an estimate to see its cost stack, CapEx/OpEx, variance and PERT band.</div>
                        </t>
                    </div>
                </div>

            </div>
        </div>
    </t>

</templates>
